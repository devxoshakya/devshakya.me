{
    "name": "api",
    "private": true,
    "scripts": {
        "dev": "uv run uvicorn api.main:app --reload --host 0.0.0.0 --port 8000",
        "build": "uv sync --locked",
        "start": "uv run uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000}",
